const system = require("../utils/system");

// In create() - validate refund window
async create(data, user = "system", qr = null) {
  // ✅ Check if refund is within window
  const windowDays = await system.refundWindowDays();
  const saleDate = new Date(sale.timestamp);
  const now = new Date();
  const daysDiff = (now - saleDate) / (1000 * 60 * 60 * 24);
  if (daysDiff > windowDays) {
    throw new Error(`Refund window of ${windowDays} days has passed`);
  }
  // ... rest of the code
}

// In create() - check if refunds are enabled
