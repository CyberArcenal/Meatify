      printer: await checkPrinterHealth(),
      // ... more checks
    };
    
    const allHealthy = Object.values(checks).every(c => c.status === 'healthy');
    return {
      status: allHealthy ? 'healthy' : 'unhealthy',
      checks,
      timestamp: new Date().toISOString()
    };
  });
  ```
- **Time Estimate:** 2 hours

