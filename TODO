### 13. **Export/Import Methods Inconsistent**
- **Files:** All services with export/import
- **Issue:** Each service implements export/import differently.
- **Action:** Standardize with BaseService.
  ```javascript
  // In BaseService
  async export(format = 'json', filters = {}, user = 'system', qr = null) {
    const result = await this.findAll({ ...filters, limit: undefined, page: undefined }, qr);
    const data = result.data;
    
    if (format === 'csv') {
      return this._toCSV(data);
    }
    return { format: 'json', data, filename: `${this.entityClass.name}_export_${Date.now()}.json` };
  }
  
  async importFromCSV(filePath, user = 'system', qr = null) {
    const records = await this._parseCSV(filePath);
    return this.bulkCreate(records, user, qr);
  }
  ```
