### Step 3: Refactor PurchaseStateService into Modules

#### `src/stateServices/purchase/modules/PurchaseNotificationModule.js`

```javascript
// src/stateServices/purchase/modules/PurchaseNotificationModule.js
const { logger } = require("../../../utils/logger");
const NotificationSender = require("../../common/NotificationSender");
const system = require("../../../utils/system");

class PurchaseNotificationModule {
  /**
   * Notify supplier about purchase status change via email (if enabled)
   * @param {Object} purchase - Purchase entity
   * @param {string} action - approved, completed, cancelled
   * @param {string} user - User performing the action
   * @param {string} reason - Cancellation reason (if applicable)
   * @param {import("typeorm").QueryRunner | null} queryRunner
   */
  async notifySupplier(purchase, action, user = "system", reason = "", queryRunner = null) {
    if (!purchase.supplier) {
      logger.warn(`[PurchaseNotification] No supplier for purchase #${purchase.id}`);
      return;
    }

    const supplier = purchase.supplier;
    const company = await system.companyName();

    let title, message, type;

    switch (action) {
      case "approved":
        title = "Purchase Order Approved";
        message = `Purchase #${purchase.referenceNo} has been approved. Please prepare the order.`;
        type = "info";
        break;
      case "completed":
        title = "Purchase Order Completed";
        message = `Purchase #${purchase.referenceNo} has been completed. Stock has been added to inventory.`;
        type = "success";
        break;
      case "cancelled":
        title = "Purchase Order Cancelled";
        message = `Purchase #${purchase.referenceNo} has been cancelled.${reason ? ` Reason: ${reason}` : ""}`;
        type = "warning";
        break;
      default:
        return;
    }

    // ─── Email to supplier ──────────────────────────────────────
    const emailEnabled = await system.emailEnabled();
    if (emailEnabled && supplier.email) {
      const emailSubject = `${title} – ${purchase.referenceNo}`;

      // Build item list with details
      let itemsList = "";
      if (purchase.purchaseItems && purchase.purchaseItems.length > 0) {
        itemsList = purchase.purchaseItems
          .map((item, index) => {
            const meatName = item.meat?.name || "Unknown Item";
            const expiryDate = item.expiryDate
              ? new Date(item.expiryDate).toLocaleDateString()
              : "N/A";
            return `  ${index + 1}. ${meatName}\n     Quantity: ${item.quantity}kg @ ₱${item.unitPrice.toFixed(2)} = ₱${item.subtotal.toFixed(2)}\n     Expiry: ${expiryDate}`;
          })
          .join("\n");
      } else {
        itemsList = "  (No items listed)";
      }

      const emailBody =
        `Dear ${supplier.name},\n\n` +
        `${message}\n\n` +
        `┌─────────────────────────────────────────\n` +
        `│ PURCHASE DETAILS\n` +
        `├─────────────────────────────────────────\n` +
        `│ Reference:  ${purchase.referenceNo}\n` +
        `│ Date:       ${new Date(purchase.orderDate).toLocaleDateString()}\n` +
        `│ Status:     ${purchase.status.toUpperCase()}\n` +
        `│ Total:      ₱${purchase.totalAmount.toFixed(2)}\n` +
        `│ Items:      ${purchase.purchaseItems?.length || 0}\n` +
        `└─────────────────────────────────────────\n\n` +
        `ITEMS:\n${itemsList}\n\n` +
        `Thank you for your business.\n\n` +
        `Regards,\n${company}`;

      await NotificationSender.sendEmail(supplier.email, emailSubject, emailBody, user, queryRunner);
    }

    // ─── In-app notification for admin ──────────────────────────
    const emailStatus = emailEnabled && supplier.email
      ? `✓ Email sent to ${supplier.email}`
      : "✗ Email not sent";

    await NotificationSender.sendInApp(
      `Purchase ${action.charAt(0).toUpperCase() + action.slice(1)}`,
      `Purchase #${purchase.referenceNo} ${action}.\nSupplier: ${supplier.name}\nAmount: ₱${purchase.totalAmount.toFixed(2)}\n${emailStatus}`,
      type,
      {
        purchaseId: purchase.id,
        referenceNo: purchase.referenceNo,
        supplierId: supplier.id,
        action,
        emailSent: emailEnabled && !!supplier.email,
      },
      user,
      queryRunner
    );
  }
}

module.exports = PurchaseNotificationModule;
```

---

#### `src/stateServices/purchase/modules/PurchaseStatusModule.js`

```javascript
// src/stateServices/purchase/modules/PurchaseStatusModule.js
const { logger } = require("../../../utils/logger");
const AuditLogger = require("../../common/AuditLogger");
const UIBroadcaster = require("../../common/UIBroadcaster");

class PurchaseStatusModule {
  /**
   * Handle purchase created
   */
  async handleCreated(purchaseId, purchase, user = "system", queryRunner = null) {
    logger.info(`[PurchaseStatus] Purchase #${purchaseId} (${purchase.referenceNo}) created by ${user}`);

    UIBroadcaster.purchase("created", {
      id: purchase.id,
      referenceNo: purchase.referenceNo,
      supplierId: purchase.supplierId,
      supplierName: purchase.supplier?.name,
      status: purchase.status,
      totalAmount: purchase.totalAmount,
      orderDate: purchase.orderDate,
      createdAt: purchase.createdAt,
    });

    await AuditLogger.logCreate("Purchase", purchaseId, purchase, user);
  }

  /**
   * Handle purchase approved
   */
  async handleApproved(purchaseId, purchase, user = "system", queryRunner = null) {
    logger.info(`[PurchaseStatus] Purchase #${purchaseId} (${purchase.referenceNo}) approved by ${user}`);

    UIBroadcaster.purchase("approved", {
      id: purchase.id,
      referenceNo: purchase.referenceNo,
      supplierId: purchase.supplierId,
      supplierName: purchase.supplier?.name,
      totalAmount: purchase.totalAmount,
      approvedAt: new Date().toISOString(),
    });

    await AuditLogger.logUpdate(
      "Purchase",
      purchaseId,
      { action: "approved" },
      { status: "approved" },
      user
    );
  }

  /**
   * Handle purchase completed
   */
  async handleCompleted(purchaseId, purchase, options = {}, user = "system", queryRunner = null) {
    const { batchCount = purchase.purchaseItems?.length || 0 } = options;
    logger.info(`[PurchaseStatus] Purchase #${purchaseId} (${purchase.referenceNo}) completed by ${user}`);

    UIBroadcaster.purchase("completed", {
      id: purchase.id,
      referenceNo: purchase.referenceNo,
      supplierId: purchase.supplierId,
      supplierName: purchase.supplier?.name,
      totalAmount: purchase.totalAmount,
      batchCount,
      completedAt: new Date().toISOString(),
    });

    await AuditLogger.logUpdate(
      "Purchase",
      purchaseId,
      { action: "completed" },
      { status: "completed" },
      user
    );
  }

  /**
   * Handle purchase cancelled
   */
  async handleCancelled(purchaseId, purchase, reason = "", user = "system", queryRunner = null) {
    logger.info(`[PurchaseStatus] Purchase #${purchaseId} (${purchase.referenceNo}) cancelled by ${user}`);

    UIBroadcaster.purchase("cancelled", {
      id: purchase.id,
      referenceNo: purchase.referenceNo,
      supplierId: purchase.supplierId,
      supplierName: purchase.supplier?.name,
      reason,
      cancelledAt: new Date().toISOString(),
    });

    await AuditLogger.logUpdate(
      "Purchase",
      purchaseId,
      { action: "cancelled", reason },
      { status: "cancelled" },
      user
    );
  }
}

module.exports = PurchaseStatusModule;
```

---

#### `src/stateServices/purchase/PurchaseStateService.js` (Orchestrator)

```javascript
// src/stateServices/purchase/PurchaseStateService.js
//@ts-check
const { logger } = require("../../utils/logger");
const Purchase = require("../../entities/Purchase");
const PurchaseStatusModule = require("./modules/PurchaseStatusModule");
const PurchaseNotificationModule = require("./modules/PurchaseNotificationModule");

/**
 * PurchaseStateService - Orchestrates purchase state transitions.
 * All methods delegate to specialized modules.
 */
class PurchaseStateService {
  /**
   * @param {import("typeorm").DataSource} dataSource
   */
  constructor(dataSource) {
    this.dataSource = dataSource;
    this.statusModule = new PurchaseStatusModule(dataSource);
    this.notificationModule = new PurchaseNotificationModule(dataSource);
    this.purchaseRepo = dataSource.getRepository(Purchase);
  }

  // ============================================================
  // 🔄 SIDE EFFECTS (called by subscriber)
  // ============================================================

  async onCreated(purchaseId, purchase, user = "system", queryRunner = null) {
    await this.statusModule.handleCreated(purchaseId, purchase, user, queryRunner);
  }

  async onApproved(purchaseId, purchase, user = "system", queryRunner = null) {
    await this.statusModule.handleApproved(purchaseId, purchase, user, queryRunner);
    await this.notificationModule.notifySupplier(purchase, "approved", user, "", queryRunner);
  }

  async onCompleted(purchaseId, purchase, options = {}, user = "system", queryRunner = null) {
    await this.statusModule.handleCompleted(purchaseId, purchase, options, user, queryRunner);
    await this.notificationModule.notifySupplier(purchase, "completed", user, "", queryRunner);
  }

  async onCancelled(purchaseId, purchase, reason = "", user = "system", queryRunner = null) {
    await this.statusModule.handleCancelled(purchaseId, purchase, reason, user, queryRunner);
    await this.notificationModule.notifySupplier(purchase, "cancelled", user, reason, queryRunner);
  }

  async onUpdated(purchaseId, purchase, changes, user = "system", queryRunner = null) {
    logger.info(`[PurchaseState] ✅ Purchase #${purchaseId} updated (fields: ${Object.keys(changes).join(", ")})`);
    // ... existing code
  }

  async onDeleted(purchaseId, purchase, user = "system", queryRunner = null) {
    // ... existing code
  }
}

module.exports = { PurchaseStateService };
```

---

### Step 4: Similar Pattern for Other Services

| Entity | Modules |
|--------|---------|
| **Batch** | `BatchStatusModule`, `BatchNotificationModule`, `BatchAuditModule` |
| **Sale** | `SaleInventoryModule`, `SaleLoyaltyModule`, `SalePaymentModule`, `SaleNotificationModule` |
| **ReturnRefund** | `ReturnStatusModule`, `ReturnNotificationModule`, `ReturnAuditModule` |
| **Supplier** | `SupplierStatusModule`, `SupplierNotificationModule`, `SupplierAuditModule` |
| **Category** | `CategoryStatusModule`, `CategoryNotificationModule`, `CategoryAuditModule` |
| **Meat** | `MeatStatusModule`, `MeatNotificationModule`, `MeatAuditModule` |

---

## 📊 Benefits of This Architecture

| Benefit | Before | After |
|---------|--------|-------|
| **File Size** | 350+ lines per file | 80-120 lines per module |
| **Testing** | Hard (mock everything) | Easy (test each module in isolation) |
| **Reusability** | None | Can import individual modules |
| **Maintainability** | Hard (one file = everything) | Easy (find what you need) |
| **Onboarding** | Overwhelming | Clear structure |
| **Merge Conflicts** | Frequent | Minimal |
| **Bug Fixes** | Risky (affects everything) | Safe (isolated to module) |

---

## 🚀 Migration Path

1. **Create common modules** (`UIBroadcaster`, `NotificationSender`, `AuditLogger`)
2. **Refactor one service** (e.g., Customer) as a proof of concept
3. **Test thoroughly** to ensure no regressions
4. **Refactor remaining services** one by one
5. **Update subscribers** to use new service structure
6. **Remove old monolithic files**

