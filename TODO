- **Action:** Create centralized error handling.
  ```javascript
  // src/utils/errors.js
  class AppError extends Error {
    constructor(message, code, statusCode = 500, details = null) {
      super(message);
      this.code = code;
      this.statusCode = statusCode;
      this.details = details;
      this.timestamp = new Date().toISOString();
    }
  }
  
  // Usage
  if (!meat) {
    throw new AppError(
      `Meat ${meatId} not found`,
      'MEAT_NOT_FOUND',
      404,
      { meatId }
    );
  }
  
  // In services - always use logger, never console
  logger.error('Failed to create batch', { 
    error: err.message, 
    stack: err.stack,
    data: data 
  });
  ```
