### 16. **Sale.js** (`src/services/SaleService.js`)

**Issue:** Hardcoded statuses, payment methods, and validation.

**Changes Needed:**
```javascript
// Add at top
const system = require("../utils/system");

// In create() - validate payment method
async create(data, user = "system", qr = null) {
  // ✅ Get enabled payment methods
  const paymentMethods = [];
  if (await system.enableCashPayment()) paymentMethods.push("cash");
  if (await system.enableCardPayment()) paymentMethods.push("card");
  if (await system.enableWalletPayment()) paymentMethods.push("wallet");
  
  if (data.paymentMethod && !paymentMethods.includes(data.paymentMethod)) {
    throw new Error(`Payment method "${data.paymentMethod}" is not enabled`);
  }
  // ... rest of the code
}

// In create() - use max discount from settings
async create(data, user = "system", qr = null) {
  const maxDiscount = await system.maxDiscountPercent();
  // ... validate discounts don't exceed maxDiscount
}

// In create() - use default payment method
async create(data, user = "system", qr = null) {
  const defaultPayment = await system.defaultPaymentMethod();
  data.paymentMethod = data.paymentMethod || defaultPayment;
  // ... rest of the code
}
```

